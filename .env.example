# LLM 配置
DEEPSEEK_URL=https://dashscope.aliyuncs.com/compatible-mode/v1
DEEPSEEK_APIKEY=your_api_key_here
DEEPSEEK_MODEL_NAME=deepseek-v4-flash

# 图片生成配置（复用 DEEPSEEK_APIKEY）
IMAGE_MODEL_NAME=wan2.7-image
IMAGE_SIZE=1024*1024
IMAGE_BASE_URL=https://dashscope.aliyuncs.com

# 日志配置
LOG_LEVEL=INFO
LOG_FILE=logs/app.log

# 知识库配置
KNOWLEDGE_BASE_PATH=./knowledge_base

LANGFUSE_SECRET_KEY=your_api_key_here
LANGFUSE_PUBLIC_KEY=your_api_key_here
LANGFUSE_BASE_URL="https://cloud.langfuse.com"
